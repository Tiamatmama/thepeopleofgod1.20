{
  "name": "emotion-center",
  "version": "1.0.0",
  "description": "情感中枢系统 - 模拟人类情感涌现",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "start:mock": "node -r ./scripts/timeshift.js src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\" && node scripts/hijack-drill.js",
    "hw:build": "node hardware/model/cli.js build",
    "hw:list": "node hardware/model/cli.js list",
    "hw:serve": "node hardware/model/cli.js serve",
    "hw:design": "node hardware/design-agent/agent.js",
    "lint": "eslint src test scripts public && node scripts/check-circular.js && node scripts/check-layering.js",
    "check:circular": "node scripts/check-circular.js",
    "check:layering": "node scripts/check-layering.js",
    "security:scan": "node scripts/security-scan.js",
    "security:deps": "node scripts/dependency-audit.js",
    "security:net": "node scripts/network-baseline.js",
    "drill:hijack": "node scripts/hijack-drill.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "adm-zip": "^0.6.1",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "web-tree-sitter": "0.20.8",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "keywords": [
    "emotion",
    "ai",
    "robot",
    "galgame"
  ],
  "author": "",
  "license": "MIT"
}
