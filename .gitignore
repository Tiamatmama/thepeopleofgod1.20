# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local

# 代码签名文件（防止被提交）
.code-signature

# Node.js依赖
node_modules/
yarn.lock

# 日志文件
*.log
logs/
developer.log

# Python 缓存
__pycache__/
*.pyc

# 数据文件
data/
backups/
*.db
*.sqlite

# 临时文件
*.tmp
*.temp
*.swp
*.swo

# 编辑器配置
.vscode/
.idea/
*.iml
*.ipr
*.iws

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 构建输出
dist/
build/
output/

# 硬件建模产物（可由 specs 重建，体积大，不进版本库）
hardware/model/out/

# 测试覆盖率
coverage/
.nyc_output/

# 敏感配置文件
config/local.js
config/secrets.js

# TLS 证书与私钥（server.key 是私钥，不能进版本库）
certs/

# 功能文档（如果不需要的话）
FUNCTIONALITY.md

# 本机运行时（node.exe 等，不进版本库）
runtime/